# ==============================================
# 1. SERVER & DATABASE CONFIGURATION
# ==============================================
PORT=8000
MONGODB_URL=your_mongodb_connection_string_here
CORS_ORIGIN=your_frontend_url_here

# ==============================================
# 2. JWT SECURITY SECRETS (The "Keys" to the Kingdom)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ACCESS and REFRESH must be DIFFERENT random strings!
# ==============================================
ACCESS_TOKEN_SECRET=your_access_token_secret_here
ACCESS_TOKEN_EXPIRY=1h

REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
REFRESH_TOKEN_EXPIRY=30d

# ==============================================
# 3. CLOUDINARY CONFIGURATION (File Storage)
# Get these from: https://cloudinary.com/console
# ==============================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
CLOUDINARY_URL=cloudinary://your_api_key_here:your_api_secret_here@your_cloud_name_here


# ==============================================
# 4. EMAIL SERVICE (Gmail / Nodemailer)
# Use a Gmail App Password, NOT your real Gmail password
# Guide: https://support.google.com/accounts/answer/185833
# ==============================================
MAIL_USER=your_gmail_address_here
MAIL_PASS=your_gmail_app_password_here


# ==============================================
# 5. APPLICATION ENVIRONMENT
# ==============================================
NODE_ENV=development

# ==============================================
# 6. THIRD-PARTY API KEYS
# ==============================================
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
