# ==============================================
# 1. SERVER & DATABASE CONFIGURATION
# ==============================================
PORT=8000
MONGODB_URL=mongodb+srv://your_username:your_password@cluster.mongodb.net
CORS_ORIGIN=http://localhost:5173

# ==============================================
# 2. JWT SECURITY SECRETS (Generate strong secrets!)
# ==============================================
ACCESS_TOKEN_SECRET=your_access_token_secret_here
ACCESS_TOKEN_EXPIRY=1h

REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
REFRESH_TOKEN_EXPIRY=30d

# ==============================================
# 3. CLOUDINARY CONFIGURATION (File Storage)
# ==============================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# ==============================================
# 4. EMAIL SERVICE (Gmail / Nodemailer)
# ==============================================
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_specific_password

# ==============================================
# 5. APPLICATION ENVIRONMENT
# ==============================================
NODE_ENV=development

# ==============================================
# 6. THIRD-PARTY API KEYS
# ==============================================
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
